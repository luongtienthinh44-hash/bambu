msgstr "Công nghệ sẵn Sàng Cấp (ROOM) của > 5."

#: page-detail.php:158
msgid "Microbiome Modulation"
msgstr "Vi Sinh Điều Chế"

#: page-detail.php:159
msgid "Antimicrobial activity in multispecies oral biofilm models"
msgstr "Kháng sinh hoạt động trong đa loài miệng sinh học mô hình"

#: page-detail.php:163
msgid "Validation Method"
msgstr "Xác Nhận Phương Pháp"

#: page-detail.php:164
msgid "16S rRNA gene sequencing."
msgstr "16 rRNA chuỗi gen."

#: page-detail.php:168
